# Ticketmaster Monitor Configuration
# Copy this file to .env and fill in your values

# Email address to receive ticket alerts
TICKETMASTER_ALERT_EMAIL=your-email@example.com

# Resend API key for sending emails
# Get one free at https://resend.com
RESEND_API_KEY=re_xxx

# Optional: Custom log file location (defaults to ~/ticketmaster_monitor.log)
# TICKETMASTER_LOG_FILE=~/my-logs/ticketmaster.log
