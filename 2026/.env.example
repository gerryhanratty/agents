# Ticketmaster Monitor Configuration
# Copy this file to .env and fill in your values

# Email address to receive ticket alerts
TICKETMASTER_ALERT_EMAIL=your-email@example.com

# Resend API key for sending emails
# Get one free at https://resend.com
RESEND_API_KEY=re_xxx

# Optional: Custom log file location (defaults to ~/ticketmaster_monitor.log)
# TICKETMASTER_LOG_FILE=~/my-logs/ticketmaster.log

# Optional: where last-seen status per event is stored, for alert de-duplication
# (defaults to ~/.ticketmaster_state.json)
# TICKETMASTER_STATE_FILE=~/.ticketmaster_state.json

# Optional: verified Resend sender (defaults to Resend's shared onboarding sender)
# TICKETMASTER_FROM_EMAIL=Ticket Monitor <alerts@yourdomain.com>

# Optional: set to 0 to run with a visible browser window if you hit a bot challenge
# TICKETMASTER_HEADLESS=1
